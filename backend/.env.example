# Copy to .env and fill in. The app fails fast at startup if a required secret is
# missing, rather than running with an empty one.

# ── Datastores ────────────────────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml.
DATABASE_URL=mysql+pymysql://recall:recall@localhost:3306/recall
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ── Object storage ────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=recall
MINIO_SECURE=false

# ── Secrets (no defaults — required) ──────────────────────────────────────────
# The only paid API in the project; embeddings and reranking run locally.
OPENAI_API_KEY=
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=

# Google OAuth. Optional in practice — email/password sign-in works without it —
# but config.py currently requires both keys to be present, so set them to empty
# strings rather than deleting the lines.
# Authorised redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Logging (optional) ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Retrieval diagnostics. INFO logs one line per search with the outcome, the best
# rerank score and how far it fell from the threshold. DEBUG adds a line per
# candidate showing which chunks were kept or dropped and why.
RAG_LOG_LEVEL=INFO

# ── Optional (defaults shown) ─────────────────────────────────────────────────
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:3000
# This service's own public origin. Builds the Google OAuth redirect, which must
# byte-match an authorised URI in the Google console. Change both for deployment.
BACKEND_URL=http://localhost:8000
# Per-user stored-bytes limit, enforced on upload. Default 10 GB.
STORAGE_QUOTA_BYTES=10737418240
